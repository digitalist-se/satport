{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
<article{{ attributes.addClass(classes) }}>
  <div class="news-teaser__container">
    <div class="news-teaser__column-one">
      <div class="news-teaser__content-wrapper">
        <div class="item-tag">{{ node.createdtime|format_date('news_date') }}</div>
        <h2 class="item-section-title news-teaser__title">
          <a href="{{ url }}">{{ label }}</a>
        </h2>
        <div class="news-teaser__intro">
          {{ content.field_intro }}
        </div>
        <a class="read-link" href="{{ url }}">
          <span class="icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
          <span>read news</span>
        </a>
      </div>
    </div>
    <div class="news-teaser__column-two">
      <a href="{{ url }}">
        {{ content.field_image.0 }}
      </a>
    </div>
  </div>
</div>
