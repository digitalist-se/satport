{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}
{%
  set classes = [
    'region',
    'region-' ~ region|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ content }}

  <div class="contact-wrapper">
    <a href="#" class="button cta white">Contact us</a>
  </div>

  <div class="mobile-menu-toggle-wrapper">
    <button id="mobile-menu-toggle" class="button reset mobile-menu-toggle">
      <svg width="48px" height="48px" viewBox="0 0 48 48" version="1.1" xmlns="http://www.w3.org/2000/svg">
        <g>
          <line x1="0" y1="17" x2="48" y2="17" stroke-width="2" />
          <line x1="0" y1="31" x2="48" y2="31" stroke-width="2" />
        </g>
        
        <g>
          <line x1="0" y1="24" x2="48" y2="24" stroke-width="2" />
          <line x1="0" y1="24" x2="48" y2="24" stroke-width="2" />
        </g>
      </svg>
    </button>
  </div>

  <div id="mobile-menu-fixed">
    <div id="mobile-menu-scroll">
      <div id="mobile-menu-wrapper">
        <ul class="mobile-menu">
          <li><a href="#">Our Focus</a></li>
          <li><a href="#">Ground Infrastructure</a></li>
          <li><a href="#">Optimizing Capacity</a></li>
          <li><a href="#">Key Figures</a></li>
          <li><a href="#">Elevating Operations</a></li>
          <li><a href="#">Flexible Growth</a></li>
          <li><a href="#">Our Aim</a></li>
        </ul>

        <div class="mobile-menu-contact-wrapper">
          <a href="#">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</div>
