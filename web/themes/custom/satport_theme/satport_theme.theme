<?php

function satport_theme_preprocess_html(&$variables) {
  // Root-relative so the links resolve correctly on nested paths (e.g. /news/...).
  $favicon_path = base_path() . \Drupal::theme()->getActiveTheme()->getPath() . '/favicon';

  //<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  $variables['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'href' => $favicon_path . '/apple-touch-icon.png',
        'rel' => 'apple-touch-icon',
        'sizes' => '180x180'
      ],
    ],
    'icon180x180'
  ];

  //<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  $variables['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'href' => $favicon_path . '/favicon-32x32.png',
        'rel' => 'icon',
        'sizes' => '32x32'
      ],
    ],
    'icon32x32'
  ];

  //<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  $variables['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'href' => $favicon_path . '/favicon-16x16.png',
        'rel' => 'icon',
        'sizes' => '16x16'
      ],
    ],
    'icon16x16'
  ];

  //<link rel="manifest" href="/site.webmanifest">
  $variables['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'href' => $favicon_path . '/site.webmanifest',
        'rel' => 'manifest',
      ],
    ],
    'manifest'
  ];
}